{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TestSprite Documentation",
  "fonts": {
    "heading": {
      "family": "StyreneA",
      "source": "https://testsprite-website-font.s3.us-east-1.amazonaws.com/fonts/StyreneAWeb-Regular.woff2+copy",
      "format": "woff2",
      "weight": 400
    },
      "body": {
        "family": "Geist",
        "source": "https://testsprite-website-font.s3.us-east-1.amazonaws.com/fonts/Geist-Medium.woff2",
        "format": "woff2",
        "weight": 500
      }
  },
  "css": [
    "/styles/tables.css",
    "/styles/kbd-dark-mode.css",
    "/styles/scrollbar.css",
    "/styles/border-radius.css"
  ],
  "colors": {
    "primary": "#19C379",
    "dark": "#101011",
    "light": "#07C983"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Website",
          "href": "https://www.testsprite.com/",
          "icon": "globe"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/QQB9tJ973e",
          "icon": "comments"
        },
        {
          "anchor": "Contact Us",
          "href": "https://calendly.com/contact-hmul/schedule",
          "icon": "address-book"
        }
      ]
    },
    "tabs": [
      {
        "tab": "MCP Server",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "mcp/getting-started/introduction",
              "mcp/getting-started/overview",
              {
                "group": "Concepts",
                "icon": "book",
                "pages": [
                  "mcp/concepts/key-terms",
                  "mcp/concepts/test-type-lifecycle",
                  "mcp/concepts/healing-observability"
                ]
              },
              "mcp/getting-started/installation",
              "mcp/getting-started/first-test"

            ]
          },
          {
            "group": "Core",
            "pages": [
              {
                "group": "Create Tests",
                "icon": "folder-plus",
                "pages": [
                  "mcp/core/create-tests-new-project",
                  "mcp/core/create-tests-new-feature"
                ]
              },
              "mcp/core/add-extra-tests",
              "mcp/core/modify-update-tests",
              "mcp/core/rerun-tests",
              "mcp/core/regenerate-tests",
              "mcp/core/deploy-to-production",
              "mcp/core/continuous-monitoring",
              "mcp/core/tools"
            ]
          },
          {
            "group": "Maintenance",
            "pages": [
              "mcp/maintenance/test-maintenance",
              "mcp/maintenance/migration-from-other-platforms",
              "mcp/maintenance/cost-performance",
              "mcp/maintenance/security-compliance"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "mcp/troubleshooting/installation-issues",
              "mcp/troubleshooting/ide-configuration-issues",
              "mcp/troubleshooting/application-detection-issues",
              "mcp/troubleshooting/test-execution-issues"
            ]
          }
        ]
      },
      {
        "tab": "Web Portal",
        "icon": "window-maximize",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "web-portal/getting-started/introduction",
              "web-portal/getting-started/overview"
            ]
          },
          {
            "group": "Core",
            "pages": [
              "web-portal/core/api-testing",
              "web-portal/core/ui-testing"
            ]
          },
          {
            "group": "Maintenance",
            "pages": [
              "web-portal/maintenance/test-lists",
              "web-portal/maintenance/monitoring"
            ]
          },
          {
            "group": "Admin",
            "pages": [
              "web-portal/admin/api-keys"
            ]
          }
        ]
      },
      {
        "tab": "Learn",
        "icon": "graduation-cap",
        "groups": [
          {
            "group": "Examples",
            "pages": [
              "learn/mcp-demo"
            ]
          },
          {
            "group": "Resoures & Help",
            "pages": [
              "learn/faq"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light-mode.svg",
    "dark": "/logo/dark-mode.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Sign In",
      "href": "https://www.testsprite.com/auth/cognito/sign-in"
    }
  },
  "contextual": {
    "options": [
     "copy"
   ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/Test_Sprite",
      "github": "https://github.com/TestSprite/Docs",
      "linkedin": "https://linkedin.com/company/testsprite",
      "discord": "https://discord.gg/QQB9tJ973e"
    }
  }
}
